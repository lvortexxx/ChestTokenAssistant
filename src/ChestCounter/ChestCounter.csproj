<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows app: the standby process has no window; the tool opens its own console (NativeConsole). -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>ChestTokenAssistant</AssemblyName>
    <RootNamespace>ChestCounter</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Single-file publish: the parser discovers its types by reflection, so no trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Small idle footprint: workstation, non-concurrent GC (no background GC thread) and a GC that gives memory back. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- The token-in-a-vortex mark of the report, as the icon of the exe, its console window, the tray and .chesttoken files. -->
    <ApplicationIcon>Assets\ChestTokenAssistant.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- What's new of this version: shown once on the home tab, and used as the GitHub release text (build.yml). -->
    <EmbeddedResource Include="..\..\RELEASE_NOTES.md" LogicalName="ReleaseNotes.md" />
    <!-- Pictures of the treasure hunt items, built into the exe (PNG, JPG, WebP, GIF): the exe never goes online and the
         player cannot change them. ItemsModel.Builtin says which file is which item. -->
    <EmbeddedResource Include="Assets\items\*.png;Assets\items\*.jpg;Assets\items\*.jpeg;Assets\items\*.webp;Assets\items\*.gif" LogicalName="items.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
